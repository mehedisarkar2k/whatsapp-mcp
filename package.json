{
  "name": "whatsapp-mcp",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "daemon": "tsx src/daemon.ts",
    "build": "tsc",
    "electron:start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.whatsappmcp.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png",
      "identity": null
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "menubar": "^9.5.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
